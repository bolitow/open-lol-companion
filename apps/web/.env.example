# Copier en .env.local (jamais commité). Lu uniquement par le serveur du site.
# Origine de services/api.
OLC_API_URL=http://127.0.0.1:3030
# Jeton de lecture émis sur le serveur par `cargo run -q -p olc-api -- token --subject web`.
# Ne jamais le préfixer NEXT_PUBLIC_ : il ne doit pas atteindre le navigateur.
OLC_API_TOKEN=
