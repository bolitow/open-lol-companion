# Copiez ce fichier en .env à la racine du dépôt (ignoré par git) et remplissez-le.
# Ne commitez jamais une vraie clé.

# Clé Riot Developer Portal (la clé de développement expire après 24 h).
RIOT_API_KEY=

# Base PostgreSQL locale (voir docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/olc

# Facultatif : niveau des journaux.
# RUST_LOG=info

# Facultatif : rétention des données personnelles (#99), en jours. Valeurs par
# défaut proposées, à valider : identifiants 30 j, parties brutes 90 j.
# OLC_RETENTION_IDENTIFIER_DAYS=30
# OLC_RETENTION_RAW_MATCH_DAYS=90

# Tests d'intégration uniquement : base d'administration où créer des bases jetables.
# OLC_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
