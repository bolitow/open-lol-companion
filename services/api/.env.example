# Développement local ; compléter le .env existant sans écraser sa clé Riot.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/olc
# Valeur aléatoire d'au moins 32 octets, fournie hors du dépôt.
OLC_API_JWT_SECRET=
OLC_API_JWT_ISSUER=open-lol-companion
OLC_API_JWT_AUDIENCE=olc-api
OLC_API_BIND=127.0.0.1:3030
OLC_API_ALLOWED_ORIGINS=http://localhost:1420,http://localhost:3000
# Sujets de jeton autorisés à l'export et à l'effacement RGPD (#99) ; vide = personne.
# OLC_API_PRIVACY_OPERATORS=
# RIOT_API_KEY est facultative ici et reste exclusivement sur le serveur.
